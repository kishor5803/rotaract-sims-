# Copy to .env for local use. Never commit real secrets.
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///rotaract_sims.db
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
FLASK_DEBUG=false

# Email (SMTP) Configuration for Notifications
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=yourclubemail@gmail.com
MAIL_PASSWORD=your-16-character-app-password
MAIL_DEFAULT_SENDER=ASTHRA Rotaract Club of SIMS <yourclubemail@gmail.com>
BOD_EMAILS=bod1@example.com,bod2@example.com,bod3@example.com
